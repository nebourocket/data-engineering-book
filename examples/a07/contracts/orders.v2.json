{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contracts/orders/1.1.0",
  "title": "orders",
  "type": "object",
  "properties": {
    "order_id": {"type": "integer", "minimum": 1},
    "customer_id": {"type": "integer", "minimum": 1},
    "status": {"enum": ["placed", "shipped", "delivered", "cancelled"]},
    "ordered_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"},
    "total_amount": {"type": "integer", "minimum": 0},
    "gift_message": {"type": "string"},
    "coupon_code": {"type": "string"}
  },
  "required": ["order_id", "customer_id", "status", "ordered_at", "total_amount"],
  "additionalProperties": false
}
