{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyEventsPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::deb-lake",
      "Condition": {"StringLike": {"s3:prefix": ["events/*"]}}
    },
    {
      "Sid": "ReadEventsObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::deb-lake/events/*"
    }
  ]
}
